# Application
APP_NAME=Traffic Violation Detection System
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Database (SQLite for development)
DATABASE_URL=sqlite:///./data/database/traffic_violations.db
# PostgreSQL example for later migration:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/traffic_violations

# Evidence storage
EVIDENCE_DIR=./data/evidence
ANNOTATED_EVIDENCE_DIR=./data/annotated

# Model weights (integrated in later prompts)
YOLO_WEIGHTS_PATH=./model_weights/yolo/best.pt
WPOD_WEIGHTS_PATH=./model_weights/wpod/wpod-net.h5
PADDLEOCR_LANG=en

# Vehicle deduplication
VEHICLE_VIOLATION_COOLDOWN_SECONDS=3600
CAMERA_SCAN_MAX_INDEX=10
FRAME_BUFFER_SIZE=30

# USB camera subsystem
CAMERA_ID=helmet-cam-01
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_BACKEND=auto
CAMERA_RECONNECT_ENABLED=true
CAMERA_RECONNECT_DELAY=2.0

# YOLOv8 inference
YOLO_MODEL_PATH=./model_weights/yolo/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto
YOLO_MAX_DETECTIONS=300
DETECTION_VISUALIZATION_ENABLED=false

# Bootstrap admin (optional; set password only in local .env)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@traffic.local
BOOTSTRAP_ADMIN_PASSWORD=

# Email notifications (background worker)
NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
